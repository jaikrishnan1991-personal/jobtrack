# Copy to .env and fill in. Never commit this file.

# Apify API token (Apify Console > Settings > API & Integrations).
# Shared by the LinkedIn, Indeed, Naukri, Instahyre and Wellfound syncs.
APIFY_TOKEN=

# Emailing recruiters from your own Gmail (Apply list > Email recruiter).
# GMAIL_APP_PASSWORD must be a Google *app password* - https://myaccount.google.com/apppasswords
# (needs 2-Step Verification on). Never put your real account password here.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
